# Copy to .env.local and fill in. Never commit .env.local.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/interviewiq?retryWrites=true&w=majority
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AUTH_SECRET=            # any long random string, e.g. output of: openssl rand -hex 32
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=   # must be an UNSIGNED upload preset

# --- Email verification (free with Gmail) ---
APP_URL=http://localhost:3000        # your site's address (used in the emailed link); set to the real URL when deployed
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=                           # your Gmail address
SMTP_PASS=                           # a 16-character Gmail App Password (needs 2-Step Verification)
EMAIL_FROM=InterviewIQ <your-gmail@gmail.com>
REQUIRE_VERIFIED_EMAIL=true          # false = don't block unverified people from posting/commenting
